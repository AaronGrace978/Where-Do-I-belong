{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Where Do I Belong",
  "version": "1.0.0",
  "identifier": "com.wheredoibelong.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Where Do I Belong",
        "width": 1480,
        "height": 920,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#07090d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2026 Aaron Grace. All rights reserved.",
    "publisher": "Aaron Grace",
    "homepage": "https://github.com/AaronGrace978/Where-Do-I-belong",
    "category": "Lifestyle",
    "shortDescription": "A love letter with a globe. Find your people.",
    "longDescription": "Spin the Earth. Click any place. Ask the compass who lives there — unique people, high-game rooms, high-trust towns — and whether the jobs will let you stay.",
    "license": "LicenseRef-Proprietary",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
